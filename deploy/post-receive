#!/bin/bash
# Runs automatically after every push to this repo (a git "post-receive"
# hook). God feeds it lines like:
#     <old-sha> <new-sha> refs/heads/main
# on stdin, one per branch that changed in the push.
#
# We react to exactly one thing: the main branch being updated. Everything
# else (docs commits, experiment branches) just falls through silently.
# Deleting main (a zero new-sha) is ignored too.

ZERO=0000000000000000000000000000000000000000

while read -r OLD NEW REF; do
    if [ "$REF" = "refs/heads/main" ] && [ "$NEW" != "$ZERO" ]; then
        echo "[hook] main -> $NEW, deploying..."
        # The hook's stdout goes back to the person pushing, but it often
        # dies with the push itself; a server-side log survives that.
        if ! /opt/ping/deploy.sh >> /var/log/ping-deploy.log 2>&1; then
            echo "[hook] DEPLOY FAILED - see /var/log/ping-deploy.log on the server"
        else
            echo "[hook] deployed $NEW - log: /var/log/ping-deploy.log"
        fi
    fi
done
