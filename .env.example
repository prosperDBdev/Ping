# Template for the server's .env file. This copy holds NO real values and is
# safe to commit. On the server:
#
#     cp .env.example .env
#     nano .env          (fill in the values)
#     chmod 600 .env     (readable by root only)
#
# Never commit the real .env. The root .gitignore already refuses it.
# Keep comments on their own lines: text after a value can be read as part of it.

# The public address of the site. No trailing slash.
PUBLIC_ORIGIN=https://ping.ebitimi.dev

# Database login, created on first start. Generate the password with:
#     openssl rand -hex 24
# Hex on purpose: the password goes inside a connection URL, where characters
# like @ / : # would break it.
MONGO_ROOT_USERNAME=ping
MONGO_ROOT_PASSWORD=

# Signs every login token. Generate with:
#     openssl rand -hex 48
# Anyone holding this can log in as any user. It never leaves the server.
JWT_SECRET=

# Cloudflare R2: the same values you use in IntelliJ.
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=ping-media

# Brevo email (optional; leave blank to run without email).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Ping
FEEDBACK_RECIPIENT_EMAIL=
