# Copy to .env (or set these in IntelliJ: Run > Edit Configurations > Environment
# Variables). Never commit the filled-in version.

# Signs and verifies every JWT. No default exists — the app refuses to start
# without it, deliberately. Generate a fresh one, at least 256 bits:
#   openssl rand -base64 48
JWT_SECRET=

# Local Docker Mongo, or a MongoDB Atlas connection string in production.
MONGODB_URI=mongodb://localhost:27017/ping

# Comma-separated list of origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Cloudflare R2 (S3-compatible object storage) for images and voice notes.
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=ping-media
